<script>
// Little confetti burst from the £1 price tag, the first time it scrolls
// into view - fires once, about a second after it appears, then cleans
// itself up. Pure DOM/CSS, no canvas/library needed.
(function(){
  var fig = document.getElementById('priceFigure');
  if(!fig) return;
  var fired = false;
  function burstConfetti(el){
    var colours = ['#00C9B1','#0066CC','#F59E0B','#EC4899','#A78BFA'];
    var rect = el.getBoundingClientRect();
    var cx = rect.left + rect.width/2;
    var cy = rect.top + rect.height/2;
    var count = 26;
    for(var i=0;i<count;i++){
      var piece = document.createElement('div');
      var angle = Math.random()*Math.PI*2;
      var dist = 60 + Math.random()*90;
      var dx = Math.cos(angle)*dist;
      var dy = Math.sin(angle)*dist - 40; // bias upward a touch
      var size = 6 + Math.random()*5;
      var colour = colours[i % colours.length];
      piece.style.cssText = 'position:fixed;left:'+cx+'px;top:'+cy+'px;'+
        'width:'+size+'px;height:'+(size*0.4)+'px;background:'+colour+';'+
        'border-radius:2px;pointer-events:none;z-index:1;opacity:1;'+
        'transform:translate(-50%,-50%) rotate('+(Math.random()*360)+'deg);'+
        'transition:transform 900ms cubic-bezier(.2,.7,.3,1),opacity 900ms ease;';
      document.body.appendChild(piece);
      requestAnimationFrame(function(p,ddx,ddy){
        return function(){
          requestAnimationFrame(function(){
            p.style.transform = 'translate(calc(-50% + '+ddx+'px), calc(-50% + '+ddy+'px + 70px)) rotate('+(Math.random()*540)+'deg)';
            p.style.opacity = '0';
          });
        };
      }(piece,dx,dy));
      setTimeout(function(p){ p.remove(); }.bind(null,piece), 950);
    }
  }
  var observer = new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if(entry.isIntersecting && !fired){
        fired = true;
        setTimeout(function(){ burstConfetti(fig); }, 900);
        observer.disconnect();
      }
    });
  }, {threshold:0.6});
  observer.observe(fig);
})();
</script>
