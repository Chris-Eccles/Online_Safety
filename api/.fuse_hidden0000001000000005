/**
 * POST /api/admin-set-dsl
 * ============================================================================
 * Admin-only safety net: sets the safeguarding/DSL team for a given licence
 * code directly, bypassing the per-school dashboard_token flow. For the case
 * where a school (especially one in a MAT, drawing seats from a shared pool)
 * never got round to setting their own DSL team via their dashboard, and you
 * want to add it for them from here instead of chasing them for it.
 *
 * Overwrites license_keys.dsl_team for that code entirely - send the full
 * list each time, same as the teacher-facing editor in dashboard.html.
 *
 * Protected the same way as the rest of admin.html - "x-admin-key" header
 * must match ADMIN_SECRET.
 * ============================================================================
 */
const { createClient } = require('@supabase/supabase-js');

const supabase = createClient(process.env.SUPABASE_URL, process.env.SUPABASE_SERVICE_ROLE_KEY);

module.exports = async (req, res) => {
  // Two-password gate: admin.html combines both fields the admin types
  // into one header as "password1::password2" - both halves must match
  // their own env var for access.
  const key = req.headers['x-admin-key'] || '';
  const parts = key.split('::');
  const ok = parts.length === 2 &&
    process.env.ADMIN_SECRET && process.env.ADMIN_SECRET_2 &&
    parts[0] === process.env.ADMIN_SECRET &&
    parts[1] === process.env.ADMIN_SECRET_2;
  if (!ok) {
    res.status(401).json({ error: 'Unauthorized' });
    return;
  }
  if (req.method !== 'POST') {
    res.status(405).json({ error: 'Method not allowed' });
    return;
  }

  try {
    const body = typeof req.body === 'string' ? JSON.parse(req.body || '{}') : (req.body || {});
    const licenseCode = (body.licenseCode || '').trim();
    const dslTeam = Array.isArray(body.dslTeam) ? body.dslTeam : null;
    if (!licenseCode || !dslTeam) {
      res.status(400).json({ error: 'licenseCode and dslTeam (array) are required.' });
      return;
    }

    // Keep existing photoUrl for any member whose name already exists on the
    // row, so an admin edit here can't accidentally wipe a photo that was
    // set some other way (mirrors the same safeguard in dashboard.html).
    const { data: existing, error: fetchErr } = await supabase
      .from('license_keys')
      .select('dsl_team')
      .eq('code', licenseCode)
      .maybeSingle();
    if (fetchErr) throw fetchErr;
    if (!existing) {
      res.status(404).json({ error: 'No licence found with that code.' });
      return;
    }
    const existingByName = {};
    (existing.dsl_team || []).forEach(m => { if (m && m.name) existingByName[m.name.trim().toLowerCase()] = m; });

    const cleaned = dslTeam
      .map(m => ({
        name: (m && m.name || '').trim(),
        room: (m && m.room || '').trim(),
        photoUrl: (m && m.photoUrl) || (existingByName[(m && m.name || '').trim().toLowerCase()] || {}).photoUrl || null
      }))
      .filter(m => m.name);

    const { error: updErr } = await supabase
      .from('license_keys')
      .update({ dsl_team: cleaned })
      .eq('code', licenseCode);
    if (updErr) throw updErr;

    res.status(200).json({ ok: true, dsl_team: cleaned });
  } catch (err) {
    console.error('admin-set-dsl failed:', err);
    res.status(500).json({ error: err.message || String(err) });
  }
};
