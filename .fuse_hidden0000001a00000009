    <a class="btn btn-primary nav-cta" href="/order">Request seats</a>
  </div>
</header>

<main>

  <section class="page-hero wrap" style="text-align:center;">
    <p class="eyebrow">Verify</p>
    <h1 class="section-title" style="max-width:none;">Check a certificate.</h1>
    <p class="section-sub" style="margin:0 auto;">Enter a certificate ID to confirm it's genuine. This only ever confirms pass/fail — it never shows a student's name or their written answers to whoever's checking.</p>
  </section>

  <section class="wrap" style="display:flex; justify-content:center;">
    <div class="verify-card">
      <div class="verify-input-row">
        <input type="text" id="certInput" class="form-input" placeholder="e.g. OR-4F9K21" maxlength="20" autocomplete="off">
        <button class="btn btn-primary" id="verifyBtn" style="flex-shrink:0;">Check</button>
      </div>
      <p class="form-hint">Certificate IDs look like OR-XXXXXX and are printed on every student's certificate.</p>
      <div class="verify-result pending" id="verifyResult"></div>
    </div>
  </section>


<script>
document.getElementById('verifyBtn').addEventListener('click', function(){
  var input = document.getElementById('certInput');
  var result = document.getElementById('verifyResult');
  var id = input.value.trim();
  result.className = 'verify-result show pending';
  if (!id) {
    result.textContent = 'Enter a certificate ID first.';
    return;
  }
  // Verification isn't wired up to a real database yet — this deliberately
  // does not fake a pass/fail result. Replace this with a real Supabase
  // lookup against student_records.cert_id once that's built.
  result.textContent = "Certificate lookup isn't live yet — we're not able to check " + id + " automatically just yet. In the meantime, contact hello@abity.co.uk with the certificate ID and we'll confirm it by hand.";
});
</script>
</main>

